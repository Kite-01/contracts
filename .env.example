# RPC of the chain to deploy to. Every "mainnet" npm script uses it; point it at
# another chain to deploy there, e.g. https://base-mainnet.g.alchemy.com/v2/<key>
FORK_URL=

# The deployer's private key (with or without 0x)
PRIVATE_KEY=

# Etherscan v2 API key, for verification. The free plan doesn't cover every chain (Base among them)
ETHERSCAN_API_KEY=

# 32-byte hex CreateX salt, for Ignition's create2 strategy and the :7702 scripts alike,
# so both deploy to the same addresses. Defaults to 0x00…00
IGNITION_SALT=

# --- Gasless deploys and upgrades (the :7702 scripts) ---

# Alchemy API key and a gas policy covering the chain, with EIP-7702 enabled
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=

# The factory proxy, for upgrade-factory:7702 and upgrade-kite:7702. Defaults to
# KiteFactoryProxy in deployments/7702/chain-<chain id>.json
FACTORY=

# Optional for deploy-factory:7702 (defaults: your EOA, your EOA, the operator in
# ignition/parameters/KiteFactory.json). Keep them, and IGNITION_SALT, the same on every
# chain to get the same factory address everywhere
ADMIN=
OPERATOR=
PROXY_OWNER=

# "false" sends the :7702 calls as ordinary transactions from PRIVATE_KEY, which pays gas
# (ALCHEMY_* not needed then). Same addresses as the sponsored path
SPONSOR=


# "false" skips verification after a :7702 deploy or upgrade
VERIFY=

# "true" sends a :7702 upgrade even when the code hasn't changed
ALLOW_SAME_IMPLEMENTATION=
